# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O ".env" nunca é commitado (ver .gitignore) — cada ambiente (sua máquina,
# o servidor de produção na Fase 10) tem o seu próprio.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Sem essa variável, o projeto roda com uma chave temporária (só em DEBUG=True).
DJANGO_SECRET_KEY=

# "True" em desenvolvimento; "False" em produção (Fase 10).
DJANGO_DEBUG=True

# Domínios que podem servir o site, separados por vírgula. Em produção,
# inclua o domínio real (ex.: turmadagurizadinha.com.br).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- E-mail ("esqueci minha senha", ver contas/urls.py) -------------------
# Deixe tudo em branco para só ver os e-mails no terminal (não envia de
# verdade) — bom para testar o fluxo sem configurar um provedor ainda.
#
# Exemplo com Brevo (gratuito, sem cartão — https://www.brevo.com):
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=seu-login-smtp-brevo
#   EMAIL_HOST_PASSWORD=sua-chave-smtp-brevo
#
# Exemplo com Gmail (exige verificação em 2 etapas + "senha de app" gerada
# em myaccount.google.com/apppasswords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=seuemail@gmail.com
#   EMAIL_HOST_PASSWORD=senha-de-app-de-16-caracteres
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Remetente que aparece nos e-mails enviados.
DEFAULT_FROM_EMAIL=Turma da Gurizadinha <nao-responda@turmadagurizadinha.com.br>
